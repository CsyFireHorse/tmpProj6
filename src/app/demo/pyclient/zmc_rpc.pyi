from typing import List, NoReturn, Optional, Sequence, Tuple, TypedDict, Union, final

@final
class ZML_HANDLE:
    """Opaque owner created only by zml_open*."""
    def __new__(cls) -> NoReturn: ...

class ZML_AxisState(TypedDict):
    axis_id: int
    axis_state: int
    error_id: int
    tick: int
    act_pos: float
    set_pos: float

class ZML_AxisStateEx(TypedDict):
    axis_id: int
    axis_state: int
    error_id: int
    tick: int
    act_pos: float
    set_pos: float
    set_vel: float
    set_acc: float
    set_position: int
    act_position: int

class ZML_CmdResultInfo(TypedDict):
    id: int
    command_type: int
    target_index: int
    target_kind: int
    status: int
    io_count: int
    error_code: int
    tick: int
    data: int
    data_ext: int

class ZML_IoMetadataEntry(TypedDict):
    mask: int
    io_number: int
    index: int
    bit_offset: int
    io_type: int
    source_kind: int
    slave_idx: int
    subindex: int
    bit_size: int
    is_input: int

class ZML_FlowCtrlConfig(TypedDict):
    period: int
    batch_size: int
    verbose_flag: int
    reserved: List[int]

class ZML_FlowCtrlStatus(TypedDict):
    period: int
    batch_size: int
    verbose_flag: int
    reserved: List[int]
    latency: int
    axis_num: int
    cycle_time: int

class ZML_HomeSdoConfig(TypedDict):
    mode: int
    offset: float
    velocity_fast: float
    velocity_slow: float
    acceleration: float
    timeout_ms: int

ZML_HOME_STATUS_IDLE: int
ZML_HOME_STATUS_BUSY: int
ZML_HOME_STATUS_DONE: int
ZML_HOME_STATUS_ERROR: int
ZML_HOME_STATUS_ABORTED: int
ZML_VERSION_INFO_MAX: int
ZML_ABOUT_INFO_MAX: int
ZML_CONTROLLER_INFO_MAX: int

